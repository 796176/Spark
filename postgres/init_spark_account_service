CREATE TABLE assigned_roles (
	account_entity_id bigint REFERENCES accounts(id),
	role_entity_id bigint REFERENCES roles(id),
	active boolean NOT NULL,
	PRIMARY KEY (account_entity_id, role_entity_id)
);
