CREATE TABLE outbox (
	id UUID NOT NULL UNIQUE,
	seqnum bigserial PRIMARY KEY,
	event_type text NOT NULL,
	content_type text NOT NULL,
	event_body text NOT NULL,
	version text NOT NULL
);
