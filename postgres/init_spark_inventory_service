CREATE TABLE item_status ( id bigint PRIMARY KEY );
INSERT INTO item_status VALUES (0), (1), (2);
CREATE TABLE items (
	id bigserial PRIMARY KEY,
	name text NOT NULL UNIQUE,
	amount integer NOT NULL,
	price_currency_amount integer NOT NULL,
	price_cent_amount integer NOT NULL,
	item_status_id bigint REFERENCES item_status(id),
	version bigint NOT NULL DEFAULT 0
);
